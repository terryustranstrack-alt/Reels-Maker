# Settings for the future online service (sign-in, credits, AI). Copy to .env.local for local work.
# None of these are needed yet. Never put these keys inside the Windows app itself.

# Supabase (Auth + Postgres)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Online AI service on Vercel (internal alpha). Set both in Vercel → Settings → Environment Variables.
ANTHROPIC_API_KEY=
RACIK_ALPHA_ACCESS_CODE=

# Later: media services
DEEPGRAM_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
