# Settings for the future online service (sign-in, credits, AI). Copy to .env.local for local work.
# None of these are needed yet. Never put these keys inside the Windows app itself.

# Supabase (Auth + Postgres)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Online AI service on Vercel (internal alpha). Set in Vercel → Settings → Environment Variables.
RACIK_ALPHA_ACCESS_CODE=
# Which AI writes the edit plan: "groq" (default, free tier) or "claude" (paid)
RACIK_AI_PROVIDER=groq
GROQ_API_KEY=
# Optional: Groq model (default openai/gpt-oss-120b)
RACIK_GROQ_MODEL=
# Only needed when RACIK_AI_PROVIDER=claude
ANTHROPIC_API_KEY=

# Later: media services
DEEPGRAM_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
