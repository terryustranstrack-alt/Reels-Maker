# Copy to .env.local for local work, and add the same names in Vercel → Settings → Environment Variables.
# None of these are needed yet: the app runs in demo mode without them.

# Supabase (Auth + Postgres)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (video storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# AI and media services (used by the render worker)
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
